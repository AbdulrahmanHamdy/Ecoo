@using ECOO.Presentation
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ECOO.Application.ViewModels.CategoryViewModel
@{
    ViewData["Title"] = "Delete Category";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="eco-form-card border-danger">
            <h2 class="text-danger mb-1"><i class="bi bi-trash me-2"></i>Delete Category</h2>
            <p class="text-muted mb-4 small">This will permanently remove the category <strong>@Model.Name</strong>. Products in this category will not be deleted but will become uncategorised.</p>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i>Yes, Delete
                    </button>
                    <a asp-action="Index" class="btn eco-btn-outline px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
