@using ECOO.Presentation
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ECOO.Application.ViewModels.CategoryViewModel
@{
    ViewData["Title"] = "Edit Category";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="eco-form-card">
            <h2 class="eco-page-title mb-1"><i class="bi bi-pencil-square me-2"></i>Edit Category</h2>

            <form asp-action="Edit" asp-route-id="@Model.Id" method="post" novalidate>
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="Id" />

                <div class="mb-4">
                    <label asp-for="Name" class="form-label eco-label"></label>
                    <input asp-for="Name" class="form-control eco-input" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn eco-btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Save
                    </button>
                    <a asp-action="Index" class="btn eco-btn-outline px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
