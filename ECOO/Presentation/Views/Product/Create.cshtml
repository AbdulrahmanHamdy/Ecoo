@using ECOO.Presentation
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model ECOO.Application.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Add Product";
}

<div class="row justify-content-center">
    <div class="col-lg-7">

        <div class="eco-form-card">
            <h2 class="eco-page-title mb-1"><i class="bi bi-plus-circle me-2"></i>Add Product</h2>
            <p class="text-muted mb-4 small">Fill in the details below to list a new eco-friendly product.</p>

            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-3">
                    <label asp-for="Name" class="form-label eco-label"></label>
                    <input asp-for="Name" class="form-control eco-input" placeholder="e.g. Bamboo Toothbrush" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Description" class="form-label eco-label"></label>
                    <textarea asp-for="Description" class="form-control eco-input" rows="4"
                              placeholder="Describe the product and its eco benefits…"></textarea>
                    <span asp-validation-for="Description" class="text-danger small"></span>
                </div>

                <div class="row g-3 mb-3">
                    <div class="col-sm-6">
                        <label asp-for="Price" class="form-label eco-label"></label>
                        <div class="input-group">
                            <span class="input-group-text eco-input-addon">$</span>
                            <input asp-for="Price" class="form-control eco-input" placeholder="0.00" />
                        </div>
                        <span asp-validation-for="Price" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="CategoryId" class="form-label eco-label"></label>
                        <select asp-for="CategoryId" asp-items="Model.Categories"
                                class="form-select eco-input">
                            <option value="">— Select category —</option>
                        </select>
                        <span asp-validation-for="CategoryId" class="text-danger small"></span>
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="ImageUrl" class="form-label eco-label"></label>
                    <input asp-for="ImageUrl" class="form-control eco-input" placeholder="/images/products/my-product.jpg" />
                    <span asp-validation-for="ImageUrl" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn eco-btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Create Product
                    </button>
                    <a asp-action="Index" class="btn eco-btn-outline px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
