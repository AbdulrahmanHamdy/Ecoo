@model ECOO.Application.ViewModels.CategoryViewModel
@{
    ViewData["Title"] = "Add Category";
}

<div class="row justify-content-center">
    <div class="col-lg-5">
        <div class="eco-form-card">
            <h2 class="eco-page-title mb-1"><i class="bi bi-plus-circle me-2"></i>Add Category</h2>
            <p class="text-muted mb-4 small">Create a new product category.</p>

            <form asp-action="Create" method="post" novalidate>
                @Html.AntiForgeryToken()

                <div class="mb-4">
                    <label asp-for="Name" class="form-label eco-label"></label>
                    <input asp-for="Name" class="form-control eco-input" placeholder="e.g. Zero-Waste Cleaning" />
                    <span asp-validation-for="Name" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn eco-btn-primary px-4">
                        <i class="bi bi-check-lg me-1"></i>Create
                    </button>
                    <a asp-action="Index" class="btn eco-btn-outline px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{ await Html.RenderPartialAsync("_ValidationScriptsPartial"); }
}
