@model ECOO.Application.ViewModels.ProductViewModel
@{
    ViewData["Title"] = "Delete Product";
}

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="eco-form-card border-danger">
            <h2 class="text-danger mb-1"><i class="bi bi-trash me-2"></i>Delete Product</h2>
            <p class="text-muted mb-4 small">Are you sure you want to permanently delete this product?</p>

            <div class="d-flex gap-3 align-items-center mb-4">
                <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.jpg" : Model.ImageUrl)"
                     alt="@Model.Name" class="eco-table-thumb rounded-2"
                     style="width:72px;height:72px;object-fit:cover;"
                     onerror="this.src='/images/placeholder.jpg'" />
                <div>
                    <h5 class="mb-0">@Model.Name</h5>
                    <span class="badge eco-badge-category">@(Model.CategoryName ?? "Uncategorised")</span>
                    <div class="eco-price-sm mt-1">$@Model.Price.ToString("F2")</div>
                </div>
            </div>

            <form asp-action="Delete" asp-route-id="@Model.Id" method="post">
                @Html.AntiForgeryToken()
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-danger px-4">
                        <i class="bi bi-trash me-1"></i>Yes, Delete
                    </button>
                    <a asp-action="Index" class="btn eco-btn-outline px-4">Cancel</a>
                </div>
            </form>
        </div>
    </div>
</div>
