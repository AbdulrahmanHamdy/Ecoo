@model IEnumerable<ECOO.Application.ViewModels.ProductViewModel>
@{
    ViewData["Title"] = "Products";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h2 class="eco-page-title mb-0"><i class="bi bi-grid me-2"></i>Products</h2>
    <a asp-action="Create" class="btn eco-btn-primary">
        <i class="bi bi-plus-lg me-1"></i>Add Product
    </a>
</div>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-box-seam fs-1 d-block mb-3"></i>
        <h5>No products yet.</h5>
        <a asp-action="Create" class="btn eco-btn-primary mt-3">Add your first product</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table eco-table align-middle">
            <thead>
                <tr>
                    <th>Image</th>
                    <th>Name</th>
                    <th>Category</th>
                    <th>Price</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td style="width:70px">
                            <img src="@(string.IsNullOrEmpty(p.ImageUrl) ? "/images/placeholder.jpg" : p.ImageUrl)"
                                 alt="@p.Name"
                                 class="eco-table-thumb"
                                 onerror="this.src='/images/placeholder.jpg'" />
                        </td>
                        <td>
                            <strong>@p.Name</strong>
                            <div class="text-muted small">@(p.Description.Length > 60 ? p.Description[..60] + "…" : p.Description)</div>
                        </td>
                        <td>
                            <span class="badge eco-badge-category">@(p.CategoryName ?? "—")</span>
                        </td>
                        <td class="eco-price-sm">$@p.Price.ToString("F2")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm eco-btn-outline me-1" title="View">
                                <i class="bi bi-eye"></i>
                            </a>
                            <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm eco-btn-warning me-1" title="Edit">
                                <i class="bi bi-pencil"></i>
                            </a>
                            <a asp-action="Delete" asp-route-id="@p.Id" class="btn btn-sm eco-btn-danger" title="Delete">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
