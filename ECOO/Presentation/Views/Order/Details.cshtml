@model ECOO.Application.ViewModels.OrderViewModel
@{
    ViewData["Title"] = $"Order #{Model.Id}";
}

<nav aria-label="breadcrumb" class="mb-4">
    <ol class="breadcrumb eco-breadcrumb">
        <li class="breadcrumb-item"><a asp-action="Index">Orders</a></li>
        <li class="breadcrumb-item active">Order #@Model.Id</li>
    </ol>
</nav>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="eco-form-card mb-3">
            <h5 class="mb-3">Items</h5>
            @foreach (var item in Model.Items)
            {
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div class="d-flex align-items-center gap-3">
                        <img src="@(string.IsNullOrEmpty(item.ProductImageUrl) ? "/images/placeholder.jpg" : item.ProductImageUrl)"
                             alt="@item.ProductName" class="rounded-2"
                             style="width:52px;height:52px;object-fit:cover"
                             onerror="this.src='/images/placeholder.jpg'" />
                        <div>
                            <div class="fw-semibold">@item.ProductName</div>
                            <small class="text-muted">@item.Quantity × $@item.Price.ToString("F2")</small>
                        </div>
                    </div>
                    <span class="fw-bold">$@item.LineTotal.ToString("F2")</span>
                </div>
            }
            <hr />
            <div class="d-flex justify-content-between fw-bold fs-5">
                <span>Order Total</span>
                <span class="eco-price">$@Model.TotalAmount.ToString("F2")</span>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="eco-summary-card p-4">
            <h5 class="mb-3">Order Info</h5>
            <dl class="row small mb-0">
                <dt class="col-5 text-muted">Order #</dt>
                <dd class="col-7"><strong>@Model.Id</strong></dd>

                <dt class="col-5 text-muted">Date</dt>
                <dd class="col-7">@Model.OrderDate.ToString("MMM dd, yyyy")</dd>

                <dt class="col-5 text-muted">Name</dt>
                <dd class="col-7">@Model.CustomerName</dd>

                <dt class="col-5 text-muted">Email</dt>
                <dd class="col-7" style="word-break:break-all">@Model.CustomerEmail</dd>

                <dt class="col-5 text-muted">Address</dt>
                <dd class="col-7">@Model.ShippingAddress</dd>
            </dl>
        </div>
    </div>
</div>

<a asp-action="Index" class="btn eco-btn-outline mt-3">
    <i class="bi bi-arrow-left me-1"></i>Back to Orders
</a>
