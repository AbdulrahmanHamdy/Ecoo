@using ECOO.Presentation
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@model IEnumerable<ECOO.Application.ViewModels.OrderViewModel>
@{
    ViewData["Title"] = "Orders";
}

<h2 class="eco-page-title mb-4"><i class="bi bi-receipt me-2"></i>Orders</h2>

@if (!Model.Any())
{
    <div class="text-center py-5 text-muted">
        <i class="bi bi-receipt fs-1 d-block mb-3"></i>
        <h5>No orders yet.</h5>
        <a asp-controller="Home" asp-action="Index" class="btn eco-btn-primary mt-3">Start Shopping</a>
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table eco-table align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Customer</th>
                    <th>Date</th>
                    <th>Total</th>
                    <th class="text-end">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var o in Model)
                {
                    <tr>
                        <td><strong>#@o.Id</strong></td>
                        <td>
                            <div>@o.CustomerName</div>
                            <small class="text-muted">@o.CustomerEmail</small>
                        </td>
                        <td class="text-muted small">@o.OrderDate.ToString("MMM dd, yyyy HH:mm")</td>
                        <td class="eco-price-sm">$@o.TotalAmount.ToString("F2")</td>
                        <td class="text-end">
                            <a asp-action="Details" asp-route-id="@o.Id" class="btn btn-sm eco-btn-outline">
                                <i class="bi bi-eye me-1"></i>View
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
