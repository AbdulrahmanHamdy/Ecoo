@model ECOO.Application.ViewModels.ProductViewModel

<!-- Reusable product card used on the Home page and Product list -->
<div class="col">
    <div class="card eco-card h-100 shadow-sm">

        <!-- Product image -->
        <a asp-controller="Home" asp-action="Index">
            <img src="@(string.IsNullOrEmpty(Model.ImageUrl) ? "/images/placeholder.jpg" : Model.ImageUrl)"
                 class="card-img-top eco-card-img"
                 alt="@Model.Name"
                 onerror="this.src='/images/placeholder.jpg'" />
        </a>

        <div class="card-body d-flex flex-column">
            <!-- Category badge -->
            @if (!string.IsNullOrEmpty(Model.CategoryName))
            {
                <span class="badge eco-badge-category mb-2 align-self-start">@Model.CategoryName</span>
            }

            <!-- Name + description -->
            <h5 class="card-title eco-card-title">@Model.Name</h5>
            <p class="card-text text-muted small flex-grow-1">
                @(Model.Description.Length > 80 ? Model.Description[..80] + "…" : Model.Description)
            </p>

            <!-- Price -->
            <div class="d-flex align-items-center justify-content-between mt-3">
                <span class="eco-price">$@Model.Price.ToString("F2")</span>

                <!-- Add to Cart -->
                <form asp-controller="Cart" asp-action="Add" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="productId" value="@Model.Id" />
                    <input type="hidden" name="returnUrl" value="@Context.Request.Path@Context.Request.QueryString" />
                    <button type="submit" class="btn btn-sm eco-btn-primary">
                        <i class="bi bi-bag-plus me-1"></i>Add
                    </button>
                </form>
            </div>

            <!-- Details link -->
            <a asp-controller="Product" asp-action="Details" asp-route-id="@Model.Id"
               class="btn btn-sm eco-btn-outline mt-2 w-100">
                View Details
            </a>
        </div>
    </div>
</div>
